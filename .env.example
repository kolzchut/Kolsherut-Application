# Copy to `.env` (git-ignored) next to docker-compose.yml. Compose reads it automatically.

# Image tags - must match what you built/loaded (the build scripts tag with each package.json `version`).
BE_IMAGE_TAG=1.0.0
FE_IMAGE_TAG=1.0.0
RETRIEVAL_IMAGE_TAG=1.0.0

# Host ports
BE_PORT=5000
FE_PORT=5173
RETRIEVAL_PORT=8200

# Backend
BE_ENV=development
ORIGIN=*
EMAIL_NOTIFIER_SENDER_EMAIL=
EMAIL_NOTIFIER_PASSWORD=
EMAIL_NOTIFIER_RECIPIENT_LIST=

# Elasticsearch shared by BE and retrieval. For the ES/reindex local replica use
# http://host.docker.internal:9200 with an empty password.
ELASTIC_URL=https://srm-staging-elasticsearch.whiletrue.industries
ELASTIC_USERNAME=elastic
ELASTIC_PASS=

# Retrieval embedding arm - switch BOTH lines together (see retrieval/.env.example).
EMBEDDING_PROVIDER=local
RETRIEVAL_EMBEDDINGS_INDEX_NAME=srm__services_retrieval_embeddings_v3_enriched
# Required only when EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDER_API_KEY=
