# Server
RETRIEVAL_SERVER_HOST=0.0.0.0
RETRIEVAL_SERVER_PORT=8200

# Elasticsearch
ELASTIC_URL=https://srm-staging-elasticsearch.whiletrue.industries
ELASTIC_USERNAME=elastic
ELASTIC_PASS=

# Indexes
SERVICES_INDEX_NAME=srm_services
SERVICE_ID_FIELD_NAME=id
# RETRIEVAL_EMBEDDINGS_INDEX_NAME is deliberately NOT set here - it lives in the "Embedding arm"
# block below, paired with EMBEDDING_PROVIDER, because a vector only means anything inside the
# index its own provider built. When A/B-testing a change to the embedded text, point it at a
# fresh index (e.g. srm__services_retrieval_embeddings_v2_...) so the incumbent stays intact for
# comparison and rollback - the index is created lazily on the first embed and there is no
# delete endpoint.
# Branch-level cards index (published by the ETL) used to enrich retrieved services.
CARDS_INDEX_NAME=srm__cards

# Logging (retrieval logs roll into a weekly index: {RETRIEVAL_LOGS_INDEX_NAME}_{week}_{year})
RETRIEVAL_LOGS_INDEX_NAME=srm__retrieval_logs
RETRIEVAL_LOG_LEVEL=INFO

# --- Embedding arm -------------------------------------------------------------------------
# EMBEDDING_PROVIDER and RETRIEVAL_EMBEDDINGS_INDEX_NAME are one setting written on two lines,
# and they must always be switched TOGETHER. 'local' runs the bundled sentence-transformers
# model (1024 dims); 'gemini' calls the Google Gemini embeddings API (3072 dims). The vectors of
# the two are NOT interchangeable, so each provider needs its own index.
#
# Switching one without the other is exactly the mistake this pairing exists to prevent:
# querying an index with the other provider's vectors does not error, it returns confident
# nonsense, and /api/services/update writes one service at a time, so a stale index name would
# silently mix 1024-dim and 3072-dim documents in one index. The startup guard now refuses to
# boot on that mismatch, so the failure is loud rather than silent - but only after the fact.
#
# Uncomment exactly one arm and comment out the other, then RESTART the service: the provider is
# resolved once per process, so an in-place edit does nothing until then.

# Arm: local (V3) - the default for local development: fully offline, no API key needed.
EMBEDDING_PROVIDER=local
RETRIEVAL_EMBEDDINGS_INDEX_NAME=srm__services_retrieval_embeddings_v3_enriched

# Arm: gemini (V4) - the deployed cluster default (Infra/values.yaml); also needs
# GEMINI_EMBEDDER_API_KEY filled in below.
# EMBEDDING_PROVIDER=gemini
# RETRIEVAL_EMBEDDINGS_INDEX_NAME=srm__services_retrieval_embeddings_v4_gemini

# Local embedding provider only (EMBEDDING_PROVIDER=local) - Gemini ignores all three.
EMBEDDING_MODEL_PATH=artifacts/retrieval-model
# E5-style text prefixes - set both to empty for models that do not use them
EMBEDDING_PASSAGE_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX="query: "

# Gemini embeddings (EMBEDDING_PROVIDER=gemini). The key is a secret and has no default.
GEMINI_EMBEDDER_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Native width is 3072. The model is Matryoshka-trained, so 1536 / 768 are valid truncations
# that trade a little quality for index size - but any change here is a NEW index, not a
# re-tune of an existing one. Truncated outputs are not unit-norm and are re-normalized.
GEMINI_EMBEDDING_DIMENSIONS=3072
# Texts per API request. SERVICE_EMBED_BATCH_SIZE (64) is the reindex batch; the provider
# re-chunks it to this, so the two knobs are independent.
GEMINI_EMBED_REQUEST_BATCH_SIZE=32
# Retry policy for 429/5xx. Exponential: base * 2**(attempt - 1) seconds.
GEMINI_EMBED_MAX_ATTEMPTS=5
GEMINI_EMBED_RETRY_BASE_SECONDS=2.0
# Service embedding text structure (field map + templates) lives in app/strings.py, not here.
# srm_services source field overrides read while rendering service text.
SERVICE_NAME_FIELD=name
SERVICE_DESCRIPTION_FIELD=description
SERVICE_DETAILS_FIELD=details
SERVICE_PHONE_NUMBERS_FIELD=phone_numbers
SERVICE_EMAIL_FIELD=email_address
SERVICE_PAYMENT_REQUIRED_FIELD=payment_required
SERVICE_PAYMENT_DETAILS_FIELD=payment_details
# Skip services with no branch card. The cards join drops any retrieved service_id with no
# matching card, so card-less services can never be returned - they only consume slots in the
# candidate pool. The card set is snapshotted at reindex start.
REQUIRE_CARD_FOR_EMBEDDING=true
# Composite aggregation page size when paging distinct service_ids out of the cards index.
CARDS_SERVICE_ID_PAGE_SIZE=2000
# Reindex scan/embed batching.
SERVICE_SCAN_BATCH_SIZE=500
SERVICE_SCAN_SCROLL_KEEP_ALIVE=30m
SERVICE_EMBED_BATCH_SIZE=64
# How many processed services between reindex progress events streamed back to the caller.
REINDEX_PROGRESS_INTERVAL=100

# Retrieval
KNN_NUM_CANDIDATES=100
# Per-retriever candidate depth (kNN + BM25) feeding the reciprocal rank fusion.
CANDIDATE_POOL_SIZE=50
# Rank constant in the reciprocal rank fusion score 1 / (rank_constant + rank).
RRF_RANK_CONSTANT=60
# Per-retriever fusion weights. Raise SEMANTIC_WEIGHT to favor kNN (meaning),
# LEXICAL_WEIGHT to favor BM25 (exact terms). Only the ratio matters; 1.0/1.0 = equal.
SEMANTIC_WEIGHT=1.0
LEXICAL_WEIGHT=1.0
# Minimum fused RRF score to return a service. The fused score is a pure function of ranks,
# so this is a fixed top-N cut, not a relevance cut. Use the semantic floors for that.
MIN_FUSED_SCORE=0.0

# Score truncation. Every cutoff below is off at these values, so retrieval returns the
# whole fused pool. The semantic floors are in COSINE units, not Elasticsearch score units
# (ES stores a cosine dense_vector as (1 + cosine) / 2).
# Absolute cosine floor; -1.0 is the cosine minimum. The only cutoff that can return nothing.
MIN_SEMANTIC_SCORE=-1.0
# Relative cosine floor: keep documents within this fraction of the best cosine. 0.0 = off.
SEMANTIC_SCORE_RATIO=0.0
# Documents BM25 found but kNN did not have no cosine. false imputes the kNN list minimum;
# true exempts them, which pins the result length to CANDIDATE_POOL_SIZE. Escape hatch only.
KEEP_LEXICAL_ONLY_DOCUMENTS=false
# Hard cap on returned documents; 0 = uncapped. The cards join shrinks the list further.
MAX_RETURNED_SERVICES=0

# Service hierarchy assembly (cards -> service/organization/branch)
# Max branches (inner hits) returned per service when collapsing cards by service_id.
CARDS_INNER_HITS_SIZE=1000
