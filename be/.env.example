# Environment key: production / stage / development (selects the ES index pair in src/vars.ts)
ENV=development
PORT=5000

# CORS origin(s) for the FE, comma-separated; first entry is the canonical origin
ORIGIN=*

# Elasticsearch connection
ELASTIC_URL=http://localhost:9200
ELASTIC_USERNAME=elastic
ELASTIC_PASS=your-password
ELASTIC_RECONNECT_TIMEOUT=5

# Search behavior
AUTOCOMPLETE_MIN_SCORE=5000
SEARCHCARDS_FIRST_LENGTH=50

# Logging
VERBOSE=false
LOG_TO_FILE=false
LOG_DURATION=10

# Email notifier (disabled when sender/password are unset)
EMAIL_NOTIFIER_SENDER_EMAIL=
EMAIL_NOTIFIER_PASSWORD=
EMAIL_NOTIFIER_RECIPIENT_LIST=
EMAIL_INTERVAL_HOURS=6

# Sitemap
SITEMAP_MINIMUM_LAST_MODIFIED_FOR_CARDS=2026-02-01T09:00:00
