# The service under evaluation (already running). Override if not on the localhost default.
RETRIEVAL_BASE_URL=http://localhost:8200

# The site whose rendered results are the ground truth.
STAGING_BASE_URL=https://staging.kolsherut.org.il

# HTTP timeout per request, in seconds.
EVAL_REQUEST_TIMEOUT_SECONDS=30

# Set to false to watch the scraper work in a visible browser window.
EVAL_BROWSER_HEADLESS=true

# Credential for the relevance judge (--judge). The judge reads this exact name explicitly and
# passes it to genai.Client(api_key=...); the name is deliberately scoped to the judge so it can
# differ from retrieval's GEMINI_EMBEDDER_API_KEY and be revoked on its own. Put the value in
# .env, which is gitignored - never here.
GEMINI_JUDGE_API_KEY=
